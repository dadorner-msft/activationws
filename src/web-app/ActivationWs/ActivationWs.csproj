<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Shown in the site footer. Bump this for a release. -->
    <Version>0.95.8</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Pinned to avoid CVE-2025-6965 in the transitive SQLitePCLRaw.lib.e_sqlite3 2.1.11 (SQLite &lt; 3.50.2). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <!-- The activation store is runtime state, never source. Keeps a developer's database out of
       the build and publish output even if the default item globs change. -->
  <ItemGroup>
    <Content Remove="**\*.db;**\*.db-shm;**\*.db-wal" />
    <None Remove="**\*.db;**\*.db-shm;**\*.db-wal" />
  </ItemGroup>

</Project>
